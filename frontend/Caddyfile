# SITE_ADDRESS examples:
#   hostelcare.example.com  -> real domain, free HTTPS certificate from Let's Encrypt
#   http://localhost        -> local test without HTTPS
{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}

	# API requests go to the C++ backend container.
	handle /api/* {
		reverse_proxy backend:18080
	}

	# Everything else is the React app (single-page app fallback).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
